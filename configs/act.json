{
  "upstream_repository": "https://github.com/tonyzhaozh/act",
  "upstream_commit": "742c753c0d4a5d87076c8f69e5628c79a8cc5488",
  "patch": "act/official.patch",
  "policy": {
    "lr": 1e-05,
    "lr_backbone": 1e-05,
    "num_queries": 100,
    "kl_weight": 10,
    "hidden_dim": 512,
    "dim_feedforward": 3200,
    "enc_layers": 4,
    "dec_layers": 7,
    "nheads": 8,
    "camera_names": [
      "top"
    ],
    "backbone": "resnet18",
    "state_dim": 5,
    "dropout": 0.1,
    "weight_decay": 0.0001
  },
  "training": {
    "device": "cuda",
    "cpu_threads": 2,
    "dataset_dir": "data/act_training/demonstrations_50_20hz",
    "num_episodes": 50,
    "batch_size": 8,
    "seed": 0,
    "num_epochs": 5000
  },
  "data": {
    "recording_hz": 20,
    "resampled_hz": 20,
    "split_seed": 1,
    "train_episodes": 40,
    "validation_episodes": 10,
    "camera": "top",
    "image_size": [
      640,
      480
    ],
    "joint_order": [
      "base",
      "shoulder",
      "elbow",
      "wrist",
      "gripper"
    ],
    "angle_units": "radians_all_five",
    "angle_source": "commanded_not_measured",
    "target": "next_grid_commanded_position",
    "action_offset": 0,
    "pause_removal": false,
    "time_warping": false,
    "normalization_episodes": "all_50_as_upstream"
  },
  "implementation": {
    "latent_dim": 32,
    "precision": "float32",
    "amp": false,
    "note": "Latent dimension is fixed in official DETRVAE; it is not a configurable model parameter here."
  }
}
